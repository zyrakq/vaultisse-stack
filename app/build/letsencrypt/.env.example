# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, letsencrypt/.env.example, pgrust/.env.example, oidc/.env.example

# Compose
COMPOSE_PROJECT_NAME=vaultisse

# Image
IMAGE=ghcr.io/albertamat/vaultisse:1.3.8

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# App
# In-container listen port; the forwarding overlay publishes the same port
# on the host. FRONT_END_URL must match the public origin (set per environment).
API_PORT=3000
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Session-cookie lifetime in milliseconds
SESSION_TIME=3600000
# Absolute session lifetime in days (forces re-login even if renewed)
MAX_SESSION_AGE_DAYS=30
REGISTRATION_ENABLED=true
TZ=UTC
COMPOSE_PROJECT_NAME=vaultisse
VIRTUAL_HOST=
API_PORT=3000
LETSENCRYPT_HOST=
LETSENCRYPT_EMAIL=
FRONT_END_URL=
TRUST_PROXY=true
ALLOW_HTTP=false
VHOST_PATH=/vhost.d/example.com
# Database (pgrust variant)
COMPOSE_EXTENDS=:docker-compose.db.yml
COMPOSE_FILE=docker-compose.yml${COMPOSE_EXTENDS:-}
POSTGRES_DB=vaultisse
POSTGRES_USER=vaultisse
POSTGRES_PASSWORD=
# OIDC (kanidm provider; SSO activates when the four OIDC_* core vars are set)
OIDC_ISSUER=https://<sso-host>/oauth2/openid/vaultisse
OIDC_CLIENT_ID=vaultisse
# Basic secret of the kanidm "vaultisse" client (kanidm oauth2 get-basic-secret)
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://<host>/auth/oidc/callback
# kanidm never grants a raw `groups` scope; the claim arrives via claim_map
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups
OIDC_PERSONAL_VAULT=true
SSO_ONLY=false