# OIDC (kanidm provider; SSO activates when the four OIDC_* core vars are set)
OIDC_ISSUER=https://<sso-host>/oauth2/openid/vaultisse
OIDC_CLIENT_ID=vaultisse
# Basic secret of the kanidm "vaultisse" client (kanidm oauth2 get-basic-secret)
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://<host>/auth/oidc/callback
# kanidm never grants a raw `groups` scope; the claim arrives via claim_map
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups
OIDC_PERSONAL_VAULT=true
SSO_ONLY=false
