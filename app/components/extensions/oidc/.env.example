# OIDC (kanidm provider; SSO activates when the four OIDC_* core vars are set)
OIDC_ISSUER=https://kanidm.af/oauth2/openid/vaultisse
OIDC_CLIENT_ID=vaultisse
# Basic secret of the kanidm "vaultisse" client (kanidm oauth2 get-basic-secret)
OIDC_CLIENT_SECRET=
# Override to http://localhost:3100/auth/oidc/callback for the forwarding env.
OIDC_REDIRECT_URI=https://vaultisse.af/auth/oidc/callback
# `groups` scope makes kanidm emit the groups claim (SPN form, name@kanidm.af)
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
OIDC_PERSONAL_VAULT=true
SSO_ONLY=false
